<Window x:Class="WinGlance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WinGlance.Views"
        xmlns:converters="clr-namespace:WinGlance.Converters"
        mc:Ignorable="d"
        Title="WinGlance"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlay}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1"
            CornerRadius="6"
            MouseRightButtonUp="Border_MouseRightButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource TitleBarBackground}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Back to Preview: the other views had no visible way out -->
                    <Button Content="&#x2190;"
                            FontSize="16"
                            Click="BackButton_Click"
                            ToolTip="Back to preview (Esc)"
                            AutomationProperties.Name="Back to preview"
                            Visibility="{Binding IsSecondaryView, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource TitleBarButtonStyle}" />
                    <TextBlock Text="WinGlance"
                               Foreground="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ViewTitle, StringFormat='{} · {0}'}"
                               Foreground="{DynamicResource DimText}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Visibility="{Binding IsSecondaryView, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <!-- Options panel: quick settings, applied and saved as they change -->
                    <Button x:Name="OptionsButton"
                            Content="&#x2699;"
                            FontSize="15"
                            Click="OptionsButton_Click"
                            ToolTip="Options"
                            AutomationProperties.Name="Options"
                            Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="&#x2014;"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            Style="{StaticResource TitleBarButtonStyle}" />
                    <!-- Full screen toggle: glyph and tooltip follow the window state (code-behind) -->
                    <Button x:Name="FullScreenButton"
                            Content="&#x25A1;"
                            FontSize="16"
                            Click="FullScreenButton_Click"
                            ToolTip="Full screen (F11)"
                            AutomationProperties.Name="Full screen"
                            Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="&#x2715;"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}" />
                </StackPanel>

                <!-- A popup is a separate window: DWM thumbnails of the panel cannot cover it,
                     and the panel's own opacity does not apply to it -->
                <Popup x:Name="OptionsPopup"
                       PlacementTarget="{Binding ElementName=TitleBar}"
                       Placement="Custom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Closed="OptionsPopup_Closed">
                    <Border DataContext="{Binding SettingsViewModel}"
                            Background="{DynamicResource TitleBarBackground}"
                            BorderBrush="{DynamicResource WindowBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Width="260">
                        <StackPanel>
                            <TextBlock Text="Options"
                                       Foreground="{DynamicResource HeaderText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <!-- Transparency -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding PanelTransparency, StringFormat='{}{0} %'}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="12" />
                                <TextBlock Text="Transparency"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="70"
                                    Value="{Binding PanelTransparency}"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Transparency" />

                            <Button Content="All settings…"
                                    Click="AllSettingsButton_Click"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0"
                                    Padding="10,3"
                                    Background="{DynamicResource ButtonBackground}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Content area: views switched by SelectedTabIndex -->
            <Grid Grid.Row="1" Margin="4">
                <!-- Preview (always present, index 0) -->
                <views:PreviewTab x:Name="PreviewView"
                                  DataContext="{Binding PreviewViewModel}" />

                <!-- Applications overlay (index 1) -->
                <views:ApplicationsTab x:Name="ApplicationsView"
                                       DataContext="{Binding ApplicationsViewModel}"
                                       Visibility="Collapsed" />

                <!-- Settings overlay (index 2) -->
                <views:SettingsTab x:Name="SettingsView"
                                   DataContext="{Binding SettingsViewModel}"
                                   Visibility="Collapsed" />

                <!-- Prompt Editor overlay (index 3) -->
                <views:PromptEditorTab x:Name="PromptEditorView"
                                       DataContext="{Binding PromptEditorViewModel}"
                                       Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>


</Window>
