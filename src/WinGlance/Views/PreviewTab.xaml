<UserControl x:Class="WinGlance.Views.PreviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinGlance.Controls"
             xmlns:converters="clr-namespace:WinGlance.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">

    <UserControl.Resources>
        <converters:LayoutToPanelConverter x:Key="LayoutToPanelConverter" />
        <converters:WindowStateToBorderBrushConverter x:Key="StateBorderConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:LlmVerdictToOpacityConverter x:Key="LlmVerdictToOpacity" />

        <!-- Group header: app icon + app name -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,6,4,2">
                <Image Source="{Binding Items[0].Icon}"
                       Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFCCCCCC"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Foreground="#FF888888"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0">
                    <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Background="Transparent">
        <ItemsControl ItemsSource="{Binding GroupedWindows}"
                      ItemsPanel="{Binding Layout, Converter={StaticResource LayoutToPanelConverter}}">

            <!-- Grouping -->
            <ItemsControl.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
            </ItemsControl.GroupStyle>

            <!-- Individual thumbnail item -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4"
                            Padding="2"
                            CornerRadius="4"
                            BorderThickness="2"
                            Background="#33000000"
                            ToolTip="{Binding Title}"
                            Cursor="Hand"
                            Opacity="{Binding LlmVerdict, Converter={StaticResource LlmVerdictToOpacity}}">
                        <!-- Multi-value border: IsActive, IsFlashing, IsHung, IsModalBlocked, NeedsAgentAttention -->
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource StateBorderConverter}">
                                <Binding Path="IsActive" />
                                <Binding Path="IsFlashing" />
                                <Binding Path="IsHung" />
                                <Binding Path="IsModalBlocked" />
                                <Binding Path="NeedsAgentAttention" />
                            </MultiBinding>
                        </Border.BorderBrush>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.ActivateWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel>
                                <!-- DWM thumbnail area -->
                                <controls:ThumbnailControl
                                    SourceHwnd="{Binding Hwnd}"
                                    ThumbnailManager="{Binding DataContext.ThumbnailManager, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                <!-- Agent badge + window title. The badge sits below the thumbnail because
                                     DWM draws thumbnails above WPF content, and the row height is fixed:
                                     a badge appearing must not shift the thumbnails that follow. -->
                                <DockPanel Height="20"
                                           LastChildFill="True"
                                           MaxWidth="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border DockPanel.Dock="Left"
                                            CornerRadius="3"
                                            Margin="2,2,0,2"
                                            Padding="5,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding Agent.Details}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#CC555555" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Agent}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Agent.Status}" Value="Busy">
                                                        <Setter Property="Background" Value="#CC0078D7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Agent.Status}" Value="Waiting">
                                                        <Setter Property="Background" Value="#CCFF8C00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Agent.Status}" Value="Running">
                                                        <Setter Property="Background" Value="#CC00897B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Agent.Text}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <!-- Window title -->
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#FFAAAAAA"
                                               FontSize="11"
                                               Margin="4,2,4,2"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Not Responding overlay -->
                            <Border Background="#88FF0000"
                                    CornerRadius="3"
                                    Visibility="{Binding IsHung, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"
                                    Padding="6,2">
                                <TextBlock Text="Not Responding"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>

                            <!-- Awaiting Action overlay (LLM verdict) -->
                            <Border Background="#CCFFA500"
                                    CornerRadius="3"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20"
                                    Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LlmVerdict}" Value="awaiting_action">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Awaiting Action"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
