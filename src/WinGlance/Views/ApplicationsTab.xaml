<UserControl x:Class="WinGlance.Views.ApplicationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">

    <UserControl.Resources>
        <!-- The default column header stays light whatever the theme -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TitleBarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorder}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,1,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <!-- Keeps the columns resizable by dragging their edge -->
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="8"
                                   Margin="0,0,-4,0"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Currently running applications:"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="12,0,0,0"
                    Padding="10,3"
                    FontSize="12"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1"
                    Cursor="Hand" />
        </StackPanel>

        <!-- App list -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Apps}"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource PrimaryText}"
                  BorderBrush="{DynamicResource WindowBorder}"
                  BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsMonitored}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Editable: the name shown as the group header in Preview -->
                    <GridViewColumn Header="Display Name" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="140"
                                         Background="{DynamicResource InputBackground}"
                                         Foreground="{DynamicResource PrimaryText}"
                                         BorderBrush="{DynamicResource InputBorder}"
                                         Padding="2,1" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Process" Width="130"
                                    DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="Windows" Width="70"
                                    DisplayMemberBinding="{Binding WindowCount}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="Save Configuration"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"
                Padding="14,5"
                FontSize="12"
                Background="{DynamicResource ButtonBackground}"
                Foreground="{DynamicResource PrimaryText}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1"
                Cursor="Hand" />
    </Grid>
</UserControl>
